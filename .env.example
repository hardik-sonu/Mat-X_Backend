# MAT-X V1 local configuration
# Dataset directory must contain the required scientific datasets.
MATX_DATASET_DIR=./data
# Keep application database and uploaded evidence in persistent storage.
MATX_STORAGE_DIR=./storage

# Required when MATX_DATABASE_BACKEND=postgres.
MATX_DATABASE_BACKEND=sqlite
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=matx-evidence
